# Browser backups (contain session tokens, cookies, history)
backups/

# Wallpapers are committed (converted to WebP, ~30MB total)
# Runtime state: currently selected default wallpaper path
wallpapers/.default
# Plaintext secrets — use sops-nix encrypted secrets.yaml instead
nixos/secrets.nix
nixos/config/home/files/.ssh/github_snorreks
nixos/config/home/files/.aws/credentials

# Per-machine local overrides — see nixos/local.nix.example
nixos/local.nix

# Build artifacts
result
result-*

# Generated caches — these were tracked and had to be removed.
#
# Two `__pycache__/*.pyc` files were committed at some point. They are build
# output: they encode a CPython version, they go stale the moment the source
# changes, and they differ between machines for no reason anyone wants. The
# 14-byte difference between two contributors' checkouts is a real cost for
# something nobody edits.
__pycache__/
*.py[cod]

# Rust build output. The crate's own .gitignore covers this directory, but the
# pattern belongs here too: a generated tree is generated wherever it appears,
# and `cargo` in the wrong directory should not produce a reviewable diff.
target/

# Age/Sops keys — never commit
*.age
keys.txt

# VPN WireGuard configs contain private keys — never commit
nixos/config/home/vpn/configs/
.claude/
secrets.md
tmp/

examples
